[
  {
    "label": "CBM: Check listing",
    "command": "./scripts/mega65.sh",
    "args": ["check", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "C64: Run in VICE",
    "command": "./scripts/mega65.sh",
    "args": ["run-c64", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "VIC-20: Run in VICE",
    "command": "./scripts/mega65.sh",
    "args": ["run-vic20", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "MEGA65: Run in XEMU",
    "command": "./scripts/mega65.sh",
    "args": ["run", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "MEGA65: Push to XEMU",
    "command": "./scripts/mega65.sh",
    "args": ["push-xemu", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "MEGA65: Push",
    "command": "./scripts/mega65.sh",
    "args": ["push", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "MEGA65: Push+run",
    "command": "./scripts/mega65.sh",
    "args": ["push-run", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "MEGA65: Send to Hardware",
    "command": "./scripts/mega65.sh",
    "args": ["push-run", "$ZED_FILE"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
